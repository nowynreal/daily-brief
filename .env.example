# Core
FRED_API_KEY=your_fred_api_key
REGION_NAME=Tennessee

# Output
OUTPUT_DIR=output
SITE_DIR=docs
INDICATOR_REGISTRY_PATH=daily_brief/config/indicator_registry_tn.json
INDICATOR_DB_PATH=output/indicator_store.sqlite3
# Site base URL for email links. Both of these are valid:
# - https://<your-username>.github.io/<repo-name>
# - https://<your-username>.github.io/<repo-name>/briefs
BASE_REVIEW_URL=https://<your-username>.github.io/<repo-name>

# Email (optional for MVP)
SEND_EMAIL=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM_NAME=Semih Yucekan
EMAIL_FROM=briefs@example.com
EMAIL_TO=user1@example.com,user2@example.com
REPLY_TO=ys4s@mtmail.mtsu
EMAIL_CC=ys4s@mtmail.mtsu

# Optional LLM mode
USE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-mini

# Optional labor-demand source endpoints for tn_online_job_postings
# Keep these empty unless you have policy-safe access to source APIs.
LINKEDIN_JOB_POSTINGS_URL=
LINKEDIN_JOB_POSTINGS_AUTH=
STATE_JOB_BOARDS_URL=
STATE_JOB_BOARDS_API_KEY=
